{"file":"index-OK5qhYdT.js","mappings":";;;;;;;;;;;;;;;;AAuBA,UAAM,QAAQ;AAWE,aAAS,MAAM;;AAC3B,cAAO,WAAM,YAAN,mBAAe,QAAQ,WAAW;AAAA,IAAuD,CACnG;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;ACXD,UAAM,WAAW;AACjB,YAAQ,IAAI,QAAQ;;;;;;;;;;;;;;;;;;;;;;;;","names":[],"sources":["../../../../components/BlogComp/BlogComp.vue","../../../../components/BlogComp/index.vue"],"sourcesContent":["<template>\n    <v-card color=\"transparent\" class=\"card-container\" :href=\"`/blogs/${props.id}`\">\n        <div class=\"pub-card\">\n            <div class=\"pub-detail\">\n                <div>\n                    <h2>\n                        <a class=\"title\" :href=\"`/blogs/${props.id}`\">{{ props.title }}</a>\n                    </h2>\n                    <div class=\"limited-content\">\n                        <p>{{props.abstract}}</p>\n                    </div>\n                    <div style=\"display: flex\">\n                        <div class=\"authors\">Date: {{props.date}} | </div> &nbsp;\n                        <div class=\"authors\" >Author: {{props.authors}}</div> \n                    </div>\n                </div>\n            </div>\n        </div>\n    </v-card>\n</template>\n\n<script setup lang=\"ts\">\nimport { computed } from \"vue\";\nconst props = defineProps(\n    {\n        title: String,\n        id: String,\n        date: String,\n        tags: Array, \n        abstract: String,\n        authors: String, \n    }\n)\n\nconst authors = computed(() => {\n    return props.authors?.replace(\"Rui Qiu\", \"<a style='font-weight: bold; color:black'>Rui Qiu</a>\")\n})\n\nconst show = true; \n</script>\n\n<style scoped>\n.pub-card {\n    display: flex;\n    justify-content: space-between;\n    padding: 20px; \n    box-shadow: 0px 2px 1px -1px var(--v-shadow-key-umbra-opacity, rgba(0, 0, 0, 0.2)), 0px 1px 1px 0px var(--v-shadow-key-penumbra-opacity, rgba(0, 0, 0, 0.14)), 0px 1px 3px 0px var(--v-shadow-key-ambient-opacity, rgba(0, 0, 0, 0.12))!important;\n}\n\n.pub-detail {\n    width: calc(100%);\n    box-sizing: border-box;\n    display: flex;\n    align-items: center;\n}\n\n.teaser {\n    box-shadow: 3px 3px 6px #888 !important;\n    border-radius: 5% !important;\n    object-fit: cover!important;\n}\n\n.author-myself {\n    font-weight: bold;\n    color: black !important;\n}\n\n.title {\n    color:purple;\n    font-weight: bold;\n    font-size: 1.7em;\n    font-family: 'EB Garamond'!important; \n}\n\n.title:hover {\n    text-decoration: underline !important;\n}\n\n.authors {\n    margin-top: 10px;\n    color: grey;\n    font-size: 1em;\n    font: Crimson Pro, serif;\n    display: inline-block\n}\n\n.journal {\n    font-style: italic;\n    font-size: 1em;\n}\n\n.limited-content {\n    margin-top: 10px;\n    display: -webkit-box;\n    -webkit-line-clamp: 3; \n    -webkit-box-orient: vertical;\n    overflow: hidden;\n    text-overflow: ellipsis; \n    \n    text-align:left; \n    line-height: 1.6; \n    color: grey;\n}\n</style>","<template>\n    <div class=\"container\">\n        <h1 class=\"section-title\">Blogs</h1>\n        <div class=\"blog-list\">\n            <BlogComp \n                v-for=\"item in blogData\"  \n                :key=\"item.id\"\n                :id=\"item.id\"\n                :title=\"item.title\"\n                :authors=\"item.authors\"\n                :date=\"item.date\"\n                :abstract=\"item.abstract\"\n                :tags=\"item.tags\"\n                >\n            </BlogComp>\n        </div>\n        \n    </div>\n</template>\n\n<script setup lang=\"ts\">\nimport type {BlogPost} from \"./types\"\nimport BlogComp from \"./BlogComp.vue\"\nimport BlogData from '../../public/assets/Blogs/index.json'\n\nconst blogData = BlogData as BlogPost[];\nconsole.log(blogData)\n</script>\n\n<style>\n.container {\n    max-width: 900px;\n    margin: 70px auto;\n    margin-bottom: 20px;\n}\n\n.section-title {\n    font-size: 2em;\n    color: #043361;\n    font-weight: 700;\n}\n\n.blog-list {\n    margin-top: 20px;\n}\n\n</style>"],"version":3}